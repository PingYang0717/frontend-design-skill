{
  "name": "frontend-project-bootstrap",
  "private": true,
  "version": "3.2.0",
  "type": "module",
  "description": "Skill 自己的工具依賴(格式化 Markdown 用);不進專案骨架。",
  "engines": {
    "node": ">=24.22.0"
  },
  "scripts": {
    "check-placeholders": "node scripts/check-placeholders.mjs",
    "format": "prettier --config assets/skeleton/.prettierrc.json --write \"**/*.md\" \"scripts/*.mjs\" --ignore-path .prettierignore"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
